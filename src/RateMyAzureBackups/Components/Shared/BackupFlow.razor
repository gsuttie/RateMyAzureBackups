@inject BackupFlowService Flows
@inject NavigationManager Nav

<div class="flow-header">
    <div>
        <h1><Icon Name="@(Flow == BackupFlowKind.RecoveryServices ? "rsv" : "bvault")" Size="26" /> @Flow.PluralLabel()</h1>
        <p class="muted">@Description</p>
    </div>
</div>

<StepBar Route="@Flow.Route()" Current="@CurrentStep" HasScan="@State.HasScan" HasJobTargets="@HasJobTargets" />

@switch (CurrentStep)
{
    case "grades":
        <GradesStep Flow="Flow" />
        break;
    case "jobs":
        <JobsStep Flow="Flow" />
        break;
    default:
        <ScopeStep Flow="Flow" OnScanCompleted="StateHasChanged" />
        break;
}

@code {
    [Parameter] public BackupFlowKind Flow { get; set; }
    [Parameter] public string? Step { get; set; }

    private FlowState State => Flows.State.For(Flow);

    private string CurrentStep
    {
        get
        {
            var requested = (Step ?? "scope").ToLowerInvariant();
            // Steps that need a scan fall back to scope when there is none (e.g. after a refresh).
            if (requested is "grades" or "jobs" && !State.HasScan) return "scope";
            if (requested == "jobs" && !HasJobTargets) return "grades";
            return requested is "grades" or "jobs" ? requested : "scope";
        }
    }

    private bool HasJobTargets => State.Scan is { } s && s.Vaults.Any(v => v.Items.Count > 0);

    private string Description => Flow == BackupFlowKind.RecoveryServices
        ? "Recovery Services vaults, their protected items (VMs, SQL and SAP HANA in VMs, Azure Files, MARS), policies, security settings and the VMs nobody backs up."
        : "Backup vaults (Data Protection), their backup instances (blobs, disks, PostgreSQL, MySQL, AKS), policies and security settings.";
}
