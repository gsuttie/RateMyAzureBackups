@inject BackupFlowService Flows
@inject IJSRuntime JS

<Modal Visible="_visible" Title="@(_findings ? "Detailed findings report" : "Summary report")" Wide="true" OnClose="Close">
    <ChildContent>
        <div class="report-tabs">
            <button class="tab @(_findings ? "" : "active")" @onclick="() => Switch(false)">Summary</button>
            <button class="tab @(_findings ? "active" : "")" @onclick="() => Switch(true)">Detailed findings</button>
        </div>
        <div class="report-preview">@((MarkupString)_html)</div>
    </ChildContent>
    <Footer>
        <span class="muted small">Word or GitHub-ready Markdown, generated from the same content as this preview.</span>
        <div class="report-downloads">
            <button class="btn btn-primary" @onclick="() => DownloadAsync(false)" disabled="@_downloading">
                <Icon Name="doc" Size="16" /> Download .docx
            </button>
            <button class="btn btn-ghost" @onclick="() => DownloadAsync(true)" disabled="@_downloading">
                <Icon Name="doc" Size="16" /> Download .md
            </button>
        </div>
    </Footer>
</Modal>

@code {
    [Parameter] public BackupFlowKind Flow { get; set; }

    private bool _visible;
    private bool _findings;
    private bool _downloading;
    private string _html = "";

    public void Open(bool findings)
    {
        _findings = findings;
        Render();
        _visible = true;
        StateHasChanged();
    }

    private void Switch(bool findings) { _findings = findings; Render(); }

    private void Render()
    {
        var ctx = Flows.ReportContext(Flow);
        _html = _findings ? BackupReportService.FindingsHtml(ctx) : BackupReportService.SummaryHtml(ctx);
    }

    private void Close() => _visible = false;

    private async Task DownloadAsync(bool markdown)
    {
        _downloading = true;
        try
        {
            var ctx = Flows.ReportContext(Flow);
            var bytes = markdown
                ? System.Text.Encoding.UTF8.GetBytes(_findings ? BackupReportService.FindingsMarkdown(ctx) : BackupReportService.SummaryMarkdown(ctx))
                : _findings ? BackupReportService.FindingsDocx(ctx) : BackupReportService.SummaryDocx(ctx);
            await JS.InvokeVoidAsync("rmab.download", BackupReportService.FileName(ctx, _findings, markdown), Convert.ToBase64String(bytes),
                markdown ? "text/markdown;charset=utf-8" : "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
        }
        finally
        {
            _downloading = false;
        }
    }
}
