@inject BackupFlowService Flows
@inject IJSRuntime JS

<Modal Visible="_visible" Title="@($"{_reportType} report")" Wide="true" OnClose="Close">
    <ChildContent>
        <div class="report-tabs">
            <button class="tab @(_reportType == BackupReportType.Summary ? "active" : "")" @onclick="() => Switch(BackupReportType.Summary)">Summary</button>
            <button class="tab @(_reportType == BackupReportType.Detailed ? "active" : "")" @onclick="() => Switch(BackupReportType.Detailed)">Detailed</button>
            <button class="tab @(_reportType == BackupReportType.Extensive ? "active" : "")" @onclick="() => Switch(BackupReportType.Extensive)">Extensive</button>
        </div>
        <div class="report-preview">@((MarkupString)_html)</div>
        @if (_copyFailed)
        {
            <div class="notice notice-error small">Markdown could not be copied. Check browser clipboard permissions and try again.</div>
        }
    </ChildContent>
    <Footer>
        <span class="muted small">Word document or Markdown (for a GitHub issue), generated from the same content as this preview.</span>
        <div class="report-downloads">
            <button class="btn btn-ghost" @onclick="CopyMarkdownAsync" title="Copy this report as GitHub-flavoured Markdown">
                <Icon Name="@(_copied ? "check" : "copy")" Size="16" /> @(_copied ? "Copied" : "Copy Markdown")
            </button>
            <button class="btn btn-primary" @onclick="DownloadAsync" disabled="@_downloading">
                @if (_downloading) { <span class="spinner sm light"></span> } else { <Icon Name="doc" Size="16" /> }
                Download .docx
            </button>
        </div>
    </Footer>
</Modal>

@code {
    [Parameter] public BackupFlowKind Flow { get; set; }

    private bool _visible;
    private BackupReportType _reportType = BackupReportType.Summary;
    private bool _downloading;
    private bool _copied;
    private bool _copyFailed;
    private string _html = "";

    public void Open(BackupReportType reportType)
    {
        _reportType = reportType;
        _copied = false;
        _copyFailed = false;
        Render();
        _visible = true;
        StateHasChanged();
    }

    public void Open(bool findings) => Open(findings ? BackupReportType.Extensive : BackupReportType.Summary);

    private async Task CopyMarkdownAsync()
    {
        _copied = false;
        _copyFailed = false;
        try
        {
            _copied = await JS.InvokeAsync<bool>("rmab.copy", Markdown(Flows.ReportContext(Flow)));
            _copyFailed = !_copied;
        }
        catch (JSException)
        {
            _copyFailed = true;
        }
    }

    private void Switch(BackupReportType reportType)
    {
        _reportType = reportType;
        _copied = false;
        _copyFailed = false;
        Render();
    }

    private void Render()
    {
        var ctx = Flows.ReportContext(Flow);
        _html = _reportType switch
        {
            BackupReportType.Summary => BackupReportService.SummaryHtml(ctx),
            BackupReportType.Detailed => BackupReportService.DetailedHtml(ctx),
            BackupReportType.Extensive => BackupReportService.ExtensiveHtml(ctx),
            _ => throw new ArgumentOutOfRangeException(nameof(_reportType), _reportType, "Unsupported report type.")
        };
    }

    private void Close() => _visible = false;

    private async Task DownloadAsync()
    {
        _downloading = true;
        try
        {
            var ctx = Flows.ReportContext(Flow);
            var bytes = _reportType switch
            {
                BackupReportType.Summary => BackupReportService.SummaryDocx(ctx),
                BackupReportType.Detailed => BackupReportService.DetailedDocx(ctx),
                BackupReportType.Extensive => BackupReportService.ExtensiveDocx(ctx),
                _ => throw new ArgumentOutOfRangeException(nameof(_reportType), _reportType, "Unsupported report type.")
            };
            await JS.InvokeVoidAsync("rmab.download", BackupReportService.FileName(ctx, _reportType), Convert.ToBase64String(bytes),
                "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
        }
        finally
        {
            _downloading = false;
        }
    }

    private string Markdown(BackupReportContext ctx) => _reportType switch
    {
        BackupReportType.Summary => BackupReportService.SummaryMarkdown(ctx),
        BackupReportType.Detailed => BackupReportService.DetailedMarkdown(ctx),
        BackupReportType.Extensive => BackupReportService.ExtensiveMarkdown(ctx),
        _ => throw new ArgumentOutOfRangeException(nameof(_reportType), _reportType, "Unsupported report type.")
    };
}
